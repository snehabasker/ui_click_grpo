.venv/
__pycache__/
.pytest_cache/
*.pyc

# trained LoRA weights (~71 MB each): regenerate with scripts/train.py
runs/*/adapter/

# raw stdout from eval runs: noisy library warnings with local absolute paths (JSON results are kept)
results/*.log

# overlays of third-party ScreenSpot screenshots: regenerate with eval_screenspot.py --draw
results/convention_screenspot_*.png

# serving/: large generated artefacts (regenerate with serving/scripts); manifests and trace.jsonl carry the sha256 checksums
serving/models/
serving/data/*/images/
serving/traces/*/images/
serving/results/raw/_*.log

# Rust build output (kept on the Linux disk in practice)
serving/router/target/
